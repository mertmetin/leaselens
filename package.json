{
  "name": "leaselens",
  "version": "1.0.0",
  "description": "Paste an Ontario residential lease and see which clauses the Residential Tenancies Act makes void. Runs entirely in your browser.",
  "type": "module",
  "license": "MIT",
  "author": "Mert Metin",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:mcp": "esbuild src/mcp/cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-mcp/leaselens-mcp.js --banner:js='#!/usr/bin/env node' --log-level=warning",
    "prepare": "npm run build:mcp",
    "mcp": "npm run build:mcp && node dist-mcp/leaselens-mcp.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "bin": {
    "leaselens-mcp": "dist-mcp/leaselens-mcp.js"
  },
  "files": [
    "dist-mcp",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ontario",
    "lease",
    "residential-tenancies-act",
    "mcp",
    "model-context-protocol",
    "tenant-rights"
  ]
}
